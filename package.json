{
  "name": "actuate-docs",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev": "astro dev",
    "build": "node -e \"require('node:fs').rmSync('node_modules/.astro',{recursive:true,force:true})\" && astro build && node scripts/check-links.mjs",
    "preview": "astro preview",
    "check-links": "node scripts/check-links.mjs",
    "build:worker": "pnpm build && node scripts/worker-assets.mjs"
  },
  "dependencies": {
    "@astrojs/starlight": "0.42.8",
    "astro": "7.4.4",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "wrangler": "^4.40.0"
  }
}
