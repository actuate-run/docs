---
// The product mark and lowercase wordmark, as on actuate.run and the dashboard.
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<a href={`${base}/`} class="site-title" aria-label="Actuate docs home">
  <img src={`${base}/favicon.svg`} alt="" width="24" height="24" />
  <span class="wordmark" translate="no">actuate</span>
  <span class="section">docs</span>
</a>

<style>
  .site-title {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    text-decoration: none;
    white-space: nowrap;
    color: var(--sl-color-white);
  }
  img {
    width: 24px;
    height: 24px;
    flex: none;
  }
  .wordmark {
    font-weight: 600;
    font-size: 18px;
    letter-spacing: -0.02em;
  }
  .section {
    font-size: 15px;
    color: var(--sl-color-gray-3);
    padding-inline-start: 9px;
    border-inline-start: 1px solid var(--sl-color-hairline-light);
    line-height: 1.1;
  }
</style>
